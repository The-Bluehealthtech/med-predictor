APP_NAME=FIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FIFA_API_URL=
FIFA_API_KEY=
FIFA_API_SECRET=
FIFA_TIMEOUT=30
FIFA_TMS_BRIDGE_URL=
FIFA_TMS_BRIDGE_TOKEN=
FIFA_TMS_CLIENT_ID=
FIFA_TMS_SECRET_KEY=
FIFA_TMS_ENVIRONMENT=beta
FIFA_TMS_TIMEOUT=15
TRANSFER_DOCUMENT_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Assistant / Dialogflow webhook security.
# Configure the secret in the runtime secret manager; never commit a real value.
GOOGLE_ASSISTANT_ENABLED=false
GOOGLE_ASSISTANT_AUTH_ENABLED=true
GOOGLE_ASSISTANT_WEBHOOK_SECRET=
# AWS Rekognition CompareFaces (federation identity review)
AWS_REKOGNITION_SIMILARITY_THRESHOLD=90
AWS_REKOGNITION_QUALITY_FILTER=AUTO

# signotec Biometrics API bridge (licensed SDK required)
SIGNOTEC_BRIDGE_URL=
SIGNOTEC_BRIDGE_TOKEN=
SIGNOTEC_TIMEOUT=15
SIGNOTEC_LICENSE_ID=

# Document electronic/digital signatures (transverse FIT capability)
SIGNOTEC_DOCUMENT_BASE_URL=
SIGNOTEC_DOCUMENT_INSTANCE_TOKEN=
SIGNOTEC_DOCUMENT_TIMEOUT=20
ADOBE_SIGN_BASE_URL=
ADOBE_SIGN_ACCESS_TOKEN=
ADOBE_SIGN_TIMEOUT=20
DOCUMENT_SIGNATURE_DISK=local
SIGNATURE_AWS_ACCESS_KEY_ID=
SIGNATURE_AWS_SECRET_ACCESS_KEY=
SIGNATURE_AWS_DEFAULT_REGION=
SIGNATURE_AWS_BUCKET=
SIGNATURE_AWS_ENDPOINT=
SIGNATURE_AWS_URL=
SIGNATURE_AWS_USE_PATH_STYLE_ENDPOINT=false
GLOBALSIGN_DSS_BASE_URL=
GLOBALSIGN_DSS_TOKEN=
GLOBALSIGN_DSS_TIMEOUT=20
