{
  "type": "participations",
  "source_label": "Exemple fournisseur (fichier de démonstration du Livrable 2)",
  "csv": { "delimiter": ",", "has_header": true },
  "not_available_tokens": ["Données non disponibles", "N/A", "NA", ""],
  "resolve": {
    "match": {
      "mode": "clubs_and_date",
      "home_club_column": "club_domicile_fifa_id",
      "away_club_column": "club_exterieur_fifa_id",
      "date_column": "date_match"
    },
    "player": { "mode": "fifa_connect_id", "column": "joueur_fifa_id" },
    "club": { "column": "club_joueur_fifa_id" }
  },
  "columns": [
    { "source": "poste_detaille", "target": "detailed_position", "kind": "position_code" },
    { "source": "titulaire", "target": "is_starter", "kind": "boolean" },
    { "source": "minute_entree", "target": "minute_in", "kind": "minutes" },
    { "source": "minute_sortie", "target": "minute_out", "kind": "minutes" },
    { "source": "numero_maillot", "target": "jersey_number", "kind": "count" }
  ],
  "attempt_success_pairs": []
}
