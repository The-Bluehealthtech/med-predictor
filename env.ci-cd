# Configuration CI/CD pour Med-Predictor
# Ce fichier contient les variables d'environnement pour l'automatisation CI/CD

# Configuration de l'application
APP_NAME="Med-Predictor"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.med-predictor.com
APP_TIMEZONE=UTC

# Configuration de la base de données
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=
DB_PASSWORD=

# Configuration du cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis

# Configuration Redis (pour le cache et les sessions)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration des logs
LOG_CHANNEL=stack
LOG_LEVEL=info

# Configuration des notifications
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WEBHOOK_URL=

# Configuration des tests
PHPUNIT_COVERAGE_MIN=80
PHPUNIT_COVERAGE_HTML=coverage/

# Configuration de l'audit
AUDIT_TIMEOUT=300
CLEANLINESS_THRESHOLD=70
ORPHAN_TABLES_THRESHOLD=30
UNUSED_MODELS_THRESHOLD=15

# Configuration Docker
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest
DOCKER_BUILD_CONTEXT=.

# Configuration de déploiement
DEPLOY_ENVIRONMENT=staging
DEPLOY_BRANCH=develop-v3
DEPLOY_AUTO_APPROVE=false

# Configuration de sécurité
ALLOWED_HOSTS=staging.med-predictor.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://staging.med-predictor.com

# Configuration des métriques
METRICS_ENABLED=true
METRICS_COLLECTOR_URL=
METRICS_API_KEY=

# Configuration de monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_URL=/health
HEALTH_CHECK_TIMEOUT=30

# Configuration des sauvegardes
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=backups/
BACKUP_COMPRESSION=true

# Configuration des alertes
ALERT_EMAIL=
ALERT_SLACK_CHANNEL=
ALERT_TEAMS_CHANNEL=

# Configuration des tests de charge
LOAD_TEST_ENABLED=false
LOAD_TEST_USERS=100
LOAD_TEST_DURATION=300

# Configuration de la sécurité
SECURITY_SCAN_ENABLED=true
DEPENDENCY_CHECK_ENABLED=true
CODE_QUALITY_CHECK_ENABLED=true

# Configuration des performances
PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=1000
MEMORY_USAGE_THRESHOLD=512

# Configuration des environnements
ENVIRONMENT_STAGING_URL=https://staging.med-predictor.com
ENVIRONMENT_PRODUCTION_URL=https://med-predictor.com
ENVIRONMENT_DEVELOPMENT_URL=http://localhost:8000

# Configuration des branches
BRANCH_MAIN=main
BRANCH_DEVELOP=develop-v3
BRANCH_STAGING=staging
BRANCH_PRODUCTION=production

# Configuration des pipelines
PIPELINE_TIMEOUT=1800
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_PARALLEL_JOBS=4

# Configuration des artefacts
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_STORAGE_PATH=artifacts/
ARTIFACT_COMPRESSION=true

# Configuration des notifications de pipeline
PIPELINE_SUCCESS_NOTIFICATION=true
PIPELINE_FAILURE_NOTIFICATION=true
PIPELINE_WARNING_NOTIFICATION=true

# Configuration des rapports
REPORT_GENERATION_ENABLED=true
REPORT_FORMATS=html,json,pdf
REPORT_STORAGE_PATH=reports/

# Configuration des tests automatisés
AUTOMATED_TESTING_ENABLED=true
TEST_PARALLELIZATION=true
TEST_TIMEOUT=300
TEST_RETRY_ATTEMPTS=2

# Configuration de la qualité du code
CODE_QUALITY_TOOLS=phpcs,phpstan,phpmd
CODE_QUALITY_THRESHOLD=80
CODE_COVERAGE_THRESHOLD=80

# Configuration des déploiements
DEPLOYMENT_STRATEGY=blue-green
DEPLOYMENT_ROLLBACK_ENABLED=true
DEPLOYMENT_VERIFICATION_ENABLED=true
DEPLOYMENT_NOTIFICATION_ENABLED=true
