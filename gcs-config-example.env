# Google Cloud Storage Configuration Example
# =========================================
# Copy this to your .env file and update the values

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT_ID=med-predictor-project
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ZONE=us-central1-a

# Google Cloud Storage Configuration
GOOGLE_CLOUD_STORAGE_BUCKET=med-predictor-storage
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=uploads/
GOOGLE_CLOUD_STORAGE_API_URI=

# Service Account Key File (for local development)
# Download from Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_CLOUD_KEY_FILE=/path/to/service-account-key.json

# Alternative: Use Application Default Credentials (for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Storage Configuration
FILESYSTEM_DISK=gcs
DEFAULT_STORAGE_DISK=gcs

# Backup Configuration
GCS_BACKUP_ENABLED=true
GCS_BACKUP_BUCKET=med-predictor-backups
GCS_BACKUP_RETENTION_DAYS=30

# CDN Configuration (optional)
GCS_CDN_ENABLED=false
GCS_CDN_URL=

# Security Configuration
GCS_SIGNED_URL_EXPIRATION=3600
GCS_PUBLIC_ACCESS=true

