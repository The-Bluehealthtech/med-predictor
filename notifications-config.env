# Configuration des Notifications CI/CD
# REMPLACEZ LES VALEURS PAR VOS VRAIES INFORMATIONS

# Configuration Slack
# 1. Allez sur https://api.slack.com/apps
# 2. Créez une app "CI/CD Notifications"
# 3. Activez "Incoming Webhooks"
# 4. Créez un webhook pour le canal #ci-cd-alerts
# 5. Copiez l'URL ci-dessous
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE/YOUR_CHANNEL/YOUR_TOKEN
SLACK_CHANNEL=#ci-cd-alerts

# Configuration Microsoft Teams
# 1. Ouvrez le canal Teams
# 2. Cliquez sur "..." → "Connectors"
# 3. Configurez "Incoming Webhook"
# 4. Copiez l'URL ci-dessous
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/YOUR_WEBHOOK_ID

# Configuration Email (Gmail)
# 1. Activez l'authentification à 2 facteurs sur Gmail
# 2. Générez un mot de passe d'application
# 3. Utilisez ces informations ci-dessous
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=im0668@gmail.com
SMTP_PASSWORD=qzneatcozirhlpst

# Webhook personnalisé (optionnel)
# Créez un endpoint HTTP pour recevoir des notifications
WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# Endpoint métriques (optionnel)
# Pour exporter les métriques vers un système externe
METRICS_ENDPOINT=https://your-metrics-endpoint.com

# Environnement de déploiement
DEPLOY_ENVIRONMENT=staging

# ==========================================
# INSTRUCTIONS DE CONFIGURATION :
# ==========================================
# 
# 1. REMPLACEZ les URLs et informations ci-dessus
# 2. SAUVEGARDEZ ce fichier
# 3. EXÉCUTEZ : ./scripts/test-notifications.sh
# 4. VÉRIFIEZ que toutes les notifications arrivent
# 
# IMPORTANT : Ne commitez JAMAIS ce fichier dans Git !
# Ajoutez-le à .gitignore
