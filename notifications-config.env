# Configuration des Notifications CI/CD
# Copiez ce fichier vers .env et configurez vos webhooks

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#ci-cd
SLACK_USERNAME=Med-Predictor Bot
SLACK_ICON_EMOJI=:rocket:

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK
TEAMS_CHANNEL=CI/CD

# Email (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ci-cd@med-predictor.com
MAIL_FROM_NAME="Med-Predictor CI/CD"

# Notifications par défaut
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_FAILURE=true
NOTIFY_ON_WARNING=true
NOTIFY_ON_DEPLOYMENT=true

# Seuils d'alerte
QUALITY_THRESHOLD=80
TEST_COVERAGE_THRESHOLD=70
PERFORMANCE_THRESHOLD=2000
